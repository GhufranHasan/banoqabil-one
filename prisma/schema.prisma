datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TEACHER
  COORDINATOR
  REGIONAL_MANAGER
  SUPER_ADMIN
}

enum ScopeType {
  SELF
  BATCH
  CAMPUS
  REGION
  GLOBAL
}

enum Gender {
  MALE
  FEMALE
}

enum GenderPolicy {
  MALE_ONLY
  FEMALE_ONLY
  MIXED
}

enum EnrollmentStatus {
  PROPOSED
  ALLOCATED
  ACTIVE
  AT_RISK
  TRANSFERRED
  RELEASED
  DROPPED
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Session {
  id        String           @id @default(cuid())
  name      String           // "Bano Qabil 5.0 — Spring 2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean          @default(false)
  offerings CourseOffering[]
  batches   Batch[]
  enrollments Enrollment[]
}

model Region {
  id       String   @id @default(cuid())
  name     String   @unique
  campuses Campus[]
}

model Campus {
  id           String           @id @default(cuid())
  name         String
  code         String           @unique
  city         String
  regionId     String
  genderPolicy GenderPolicy     @default(MIXED)
  region       Region           @relation(fields: [regionId], references: [id])
  offerings    CourseOffering[]
  timeSlots    TimeSlot[]
  batches      Batch[]

  @@index([regionId])
}

model Course {
  id               String           @id @default(cuid())
  name             String           // "Web Development"
  code             String           @unique
  durationWeeks    Int              @default(12)
  sessionsPerWeek  Int              @default(3)
  minAttendancePct Int              @default(75) // certification threshold
  aliases          String[]         // seeds LLM canonicalisation
  offerings        CourseOffering[]
}

model CourseOffering {
  id            String          @id @default(cuid())
  sessionId     String
  campusId      String
  courseId      String
  genderPolicy  GenderPolicy
  totalCapacity Int
  session       Session         @relation(fields: [sessionId], references: [id])
  campus        Campus          @relation(fields: [campusId], references: [id])
  course        Course          @relation(fields: [courseId], references: [id])
  batches       Batch[]
  waitlist      WaitlistEntry[]

  @@unique([sessionId, campusId, courseId, genderPolicy])
}

model TimeSlot {
  id        String   @id @default(cuid())
  campusId  String
  label     String   // "Morning" | "Evening" | "Afternoon" | "Weekend"
  daysMask  Int      // bitmask Mon..Sun
  startTime String   // "09:00"
  endTime   String   // "12:00"
  campus    Campus   @relation(fields: [campusId], references: [id])
  batches   Batch[]
}

model Batch {
  id           String              @id @default(cuid())
  name         String              // "WD-GUL-M-A"
  sessionId    String
  offeringId   String
  campusId     String
  timeSlotId   String
  capacity     Int                 @default(30)
  minViable    Int                 @default(12)
  genderPolicy GenderPolicy
  room         String?
  session      Session             @relation(fields: [sessionId], references: [id])
  offering     CourseOffering      @relation(fields: [offeringId], references: [id])
  campus       Campus              @relation(fields: [campusId], references: [id])
  timeSlot     TimeSlot            @relation(fields: [timeSlotId], references: [id])
  enrollments  Enrollment[]
  assignments  TeacherAssignment[]
  classes      ClassSession[]

  @@index([sessionId, offeringId])
}

model Student {
  id              String         @id @default(cuid())
  fullName        String
  normalizedName  String         // for pg_trgm & fast search
  gender          Gender
  dateOfBirth     DateTime
  isMinor         Boolean        // derived; gates contact visibility
  phoneNormalized String?
  emailNormalized String?
  cnicHash        String?        @unique // NEVER plaintext
  cnicMasked      String?        // "•••••-•••••1-2"
  city            String?
  hasLaptop       Boolean        @default(true)
  enrollments     Enrollment[]
  waitlistEntries WaitlistEntry[]

  @@index([normalizedName])
  @@index([phoneNormalized])
}

model Enrollment {
  id            String             @id @default(cuid())
  studentId     String
  batchId       String
  sessionId     String
  status        EnrollmentStatus   @default(PROPOSED)
  allocatedAt   DateTime?
  seatHeldUntil DateTime?          // waitlist offer expiry
  releasedAt    DateTime?
  releaseReason String?
  student       Student            @relation(fields: [studentId], references: [id])
  batch         Batch              @relation(fields: [batchId], references: [id])
  session       Session            @relation(fields: [sessionId], references: [id])
  attendance    AttendanceRecord[]
  followUps     FollowUp[]

  @@unique([studentId, sessionId]) // one course per student per cohort
  @@index([batchId, status])
}

model Teacher {
  id                String              @id @default(cuid())
  fullName          String
  email             String              @unique
  specialization    String
  maxWeeklyBatches  Int                 @default(4)
  assignments       TeacherAssignment[]
}

model TeacherAssignment {
  id        String   @id @default(cuid())
  teacherId String
  batchId   String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  batch     Batch    @relation(fields: [batchId], references: [id])

  @@unique([teacherId, batchId])
}

model ClassSession {
  id          String             @id @default(cuid())
  batchId     String
  scheduledAt DateTime
  status      String             @default("SCHEDULED") // SCHEDULED HELD CANCELLED
  batch       Batch              @relation(fields: [batchId], references: [id])
  records     AttendanceRecord[]

  @@unique([batchId, scheduledAt])
}

model AttendanceRecord {
  id             String       @id @default(cuid())
  classSessionId String
  enrollmentId   String
  status         String       // PRESENT ABSENT LATE EXCUSED
  markedById     String
  markedAt       DateTime     @default(now())
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id])

  @@unique([classSessionId, enrollmentId])
  @@index([enrollmentId, status])
}

model WaitlistEntry {
  id              String         @id @default(cuid())
  studentId       String
  offeringId      String
  timeSlotIds     String[]       // acceptable slots
  appliedAt       DateTime
  interviewPassed Boolean        @default(false)
  score           Int            @default(80)
  status          String         @default("WAITING") // WAITING OFFERED ENROLLED EXPIRED
  student         Student        @relation(fields: [studentId], references: [id])
  offering        CourseOffering @relation(fields: [offeringId], references: [id])

  @@index([offeringId, status])
}

model AllocationRun {
  id           String               @id @default(cuid())
  sessionId    String
  campusId     String
  courseId     String
  mode         String               // ALLOCATE | REOPTIMIZE
  stateHash    String               // guards stale approval
  stats        Json                 // allocated, unallocated, batches, etc.
  status       ApprovalStatus       @default(PENDING)
  createdById  String
  approvedById String?
  createdAt    DateTime             @default(now())
  proposals    AllocationProposal[]
}

model AllocationProposal {
  id         String        @id @default(cuid())
  runId      String
  studentId  String
  batchId    String?       // null = unallocatable
  reasonCode String        // machine-readable
  reasonText String        // LLM-rendered, human-readable
  isFeasible Boolean       @default(true)
  run        AllocationRun @relation(fields: [runId], references: [id])
}

model FollowUp {
  id           String     @id @default(cuid())
  studentId    String
  enrollmentId String
  reasonCode   String     // NO_SHOW CERT_IMPOSSIBLE ...
  priority     Priority
  score        Int
  explanation  String     // grounded, generated from facts
  status       String     @default("PENDING") // PENDING | CONTACTED | RESOLVED | UNREACHABLE | WITHDRAWN
  assignedToId String?
  notes        Json       @default("[]")
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([status, priority])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  Role
  action     String   // APPROVE_ALLOCATION, NL_QUERY, SCOPE_DENIED, RELEASE_SEAT
  entityType String
  entityId   String?
  details    String   @default("")
  before     Json?
  after      Json?
  scopeJson  Json     // the ScopeContext at request time
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model NLQueryLog {
  id          String   @id @default(cuid())
  userId      String
  role        Role
  question    String
  querySpec   Json?
  compiledSql String?
  outcome     String   // ANSWERED | REFUSED_INTENT | REFUSED_POLICY | ERROR
  rowCount    Int?
  latencyMs   Int?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  role      Role?
  title     String
  message   String
  link      String?
  priority  Priority @default(MEDIUM)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TransferRequest {
  id               String         @id @default(cuid())
  enrollmentId     String
  studentId        String
  currentBatchId   String
  targetBatchId    String
  currentCampusId  String
  targetCampusId   String
  isCrossCampus    Boolean        @default(false)
  reason           String
  status           ApprovalStatus @default(PENDING)
  requestedById    String
  approvedById     String?
  rejectionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, isCrossCampus])
}

model DuplicateCandidate {
  id          String   @id @default(cuid())
  studentAId  String
  studentBId  String
  confidence  String   // CERTAIN | LIKELY | POSSIBLE
  matchReason String
  status      String   @default("PENDING") // PENDING | MERGED | DISMISSED
  campusId    String
  detectedAt  DateTime @default(now())

  @@index([status, confidence])
}

model ImportJob {
  id             String        @id @default(cuid())
  fileName       String
  totalRows      Int
  validRows      Int
  quarantinedRows Int
  status         String        @default("PENDING") // PENDING | MAPPED | COMMITTED | FAILED
  mappings       Json          // Array of sourceHeader -> targetField mappings
  uploadedById   String
  createdAt      DateTime      @default(now())
  rows           ImportRow[]
  issues         ImportIssue[]
}

model ImportRow {
  id          String      @id @default(cuid())
  jobId       String
  rowNumber   Int
  rawData     Json
  parsedData  Json?
  isQuarantine Boolean    @default(false)
  job         ImportJob   @relation(fields: [jobId], references: [id])

  @@index([jobId, isQuarantine])
}

model ImportIssue {
  id        String    @id @default(cuid())
  jobId     String
  rowNumber Int
  field     String
  issueType String    // MISSING_CNIC, INVALID_PHONE, PROMPT_INJECTION
  message   String
  job       ImportJob @relation(fields: [jobId], references: [id])
}

model Recommendation {
  id          String   @id @default(cuid())
  type        String   // SEAT_RECOVERY, BATCH_SPLIT, TRAINER_REBALANCE, TRANSFER
  title       String
  description String
  impactScore Int      @default(80)
  metadata    Json     @default("{}")
  status      String   @default("OPEN") // OPEN | APPLIED | DISMISSED
  createdAt   DateTime @default(now())
}

model Approval {
  id          String         @id @default(cuid())
  entityType  String         // ALLOCATION_RUN, TRANSFER_REQUEST, DEAD_SEAT_RELEASE
  entityId    String
  status      ApprovalStatus @default(PENDING)
  requestedBy String
  reviewedBy  String?
  decision    String?
  comments    String?
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([entityType, entityId])
}
